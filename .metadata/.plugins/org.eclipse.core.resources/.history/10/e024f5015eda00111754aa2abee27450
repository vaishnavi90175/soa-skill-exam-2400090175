
package com.klef.soa.exam.repository;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.util.List;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;

import com.klef.soa.exam.entity.Asset;

@DataJpaTest
public class AssetRepositoryTests {

    @Autowired
    private AssetRepository repository;

    @Test
    public void testSaveAsset() {
        Asset asset = new Asset();
        asset.setName("Laptop");
        asset.setType("Electronics");
        asset.setStatus("Available");
        asset.setLocation("Lab1");

        Asset saved = repository.save(asset);

        assertNotNull(saved.getAssetId());
    }

    @Test
    public void testFindByName() {
        Asset asset = new Asset();
        asset.setName("Laptop");
        asset.setType("Electronics");
        asset.setStatus("Available");
        asset.setLocation("Lab1");

        repository.save(asset);

        List<Asset> result = repository.findByName("Laptop");

        assertFalse(result.isEmpty());
        assertEquals("Laptop", result.get(0).getName());
    }

    @Test
    public void testFindByType() {
        Asset asset = new Asset();
        asset.setName("Fan");
        asset.setType("Electronics");
        asset.setStatus("In use");
        asset.setLocation("Lab1");

        repository.save(asset);

        List<Asset> result = repository.findByType("Electronics");

        assertFalse(result.isEmpty());
        assertEquals("Electronics", result.get(0).getType());
    }

    @Test
    public void testFindById() {
        Asset asset = new Asset();
        asset.setName("table");
        asset.setType("furniture");
        asset.setStatus("Available");
        asset.setLocation("Lab1");

        Asset saved = repository.save(asset);

        assertTrue(repository.findById(saved.getAssetId()).isPresent());
    }

    @Test
    public void testDeleteAsset() {
        Asset asset = new Asset();
        asset.setName("Chair");
        asset.setType("furniture");
        asset.setStatus("In use");
        asset.setLocation("Lab1");

        Asset saved = repository.save(asset);
        repository.deleteById(saved.getAssetId());

        assertFalse(repository.findById(saved.getAssetId()).isPresent());
    }
}

}
